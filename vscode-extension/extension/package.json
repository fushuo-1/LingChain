{
  "name": "@lingchain/embedded-c-client",
  "displayName": "LingµChain Embedded C",
  "description": "LSP client for embedded C projects (Keil MDK / ARM Compiler)",
  "version": "0.1.0",
  "publisher": "lingchain",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.uvprojx",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lingchain.selectProject",
        "title": "LingµChain: Select Keil Project"
      }
    ],
    "configuration": {
      "title": "LingµChain",
      "properties": {
        "lingchain.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the LSP server module (leave empty to use bundled)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
