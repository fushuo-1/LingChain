{
  "name": "lingchain-embedded-c",
  "displayName": "LingChain Embedded C",
  "description": "LSP client for embedded C projects (Keil MDK / ARM Compiler)",
  "version": "0.1.0",
  "publisher": "lingchain",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.uvprojx",
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lingchain.selectProject",
        "title": "LingChain: Select Keil Project"
      }
    ],
    "configuration": {
      "title": "LingChain",
      "properties": {
        "lingchain.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the LSP server module (leave empty to use bundled)"
        },
        "lingchain.armclang.path": {
          "type": "string",
          "default": "",
          "description": "Path to armclang(.exe). Leave empty to auto-detect from KEIL_ARMCLANG, the Keil registry, common install paths, or PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "watch": "tsc -watch -p tsconfig.json",
    "bundle-extension": "node ../scripts/bundle-extension.js",
    "bundle-server": "node ../scripts/bundle-deps.js",
    "vscode:prepublish": "npm run compile && npm run bundle-extension && npm run bundle-server",
    "package": "npm run vscode:prepublish && vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
