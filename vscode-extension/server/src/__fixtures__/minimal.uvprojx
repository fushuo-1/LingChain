        </TargetCommonOption>
        <TargetArmAds>
          <Cads>
            <VariousControls>
              <Define>DEBUG,STM32F407xx</Define>
              <IncludePath>./Inc;./Drivers/CMSIS/Include</IncludePath>
            </VariousControls>
